// COUNTDOWN TIMER
// December 19, 2026 at 5:00 PM

const eventDate = new Date("December 19, 2026 17:00:00").getTime();

function updateCountdown() {
  const now = new Date().getTime();
  const distance = eventDate - now;

  const daysElement = document.getElementById("days");
  const hoursElement = document.getElementById("hours");
  const minutesElement = document.getElementById("minutes");
  const secondsElement = document.getElementById("seconds");

  if (distance <= 0) {
    daysElement.textContent = "00";
    hoursElement.textContent = "00";
    minutesElement.textContent = "00";
    secondsElement.textContent = "00";
    return;
  }

  const days = Math.floor(distance / (1000 * 60 * 60 * 24));
  const hours = Math.floor(
    (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)
  );
  const minutes = Math.floor(
    (distance % (1000 * 60 * 60)) / (1000 * 60)
  );
  const seconds = Math.floor(
    (distance % (1000 * 60)) / 1000
  );

  daysElement.textContent = String(days).padStart(2, "0");
  hoursElement.textContent = String(hours).padStart(2, "0");
  minutesElement.textContent = String(minutes).padStart(2, "0");
  secondsElement.textContent = String(seconds).padStart(2, "0");
}

updateCountdown();
setInterval(updateCountdown, 1000);


// MOBILE NAVIGATION

const menuToggle = document.querySelector(".menu-toggle");
const siteNav = document.querySelector(".site-nav");

if (menuToggle && siteNav) {
  menuToggle.addEventListener("click", () => {
    const isOpen = siteNav.classList.toggle("open");

    menuToggle.setAttribute("aria-expanded", isOpen);
    menuToggle.textContent = isOpen ? "✕" : "☰";
  });

  // Close the menu after selecting a section
  siteNav.querySelectorAll("a").forEach(link => {
    link.addEventListener("click", () => {
      siteNav.classList.remove("open");
      menuToggle.setAttribute("aria-expanded", "false");
      menuToggle.textContent = "☰";
    });
  });
}


// RSVP PREVIEW

const rsvpForm = document.getElementById("rsvp-form");
const formNote = document.getElementById("form-note");

if (rsvpForm && formNote) {
  rsvpForm.addEventListener("submit", event => {
    event.preventDefault();

    const guestName = document.getElementById("guest-name").value.trim();
    const attendance = document.getElementById("attendance").value;

    if (!guestName || !attendance) {
      formNote.textContent = "Please complete both fields.";
      return;
    }

    if (attendance === "yes") {
      formNote.textContent =
        `Thank you, ${guestName}! Your preview RSVP is ready. We'll need to connect a form service to save it.`;
    } else {
      formNote.textContent =
        `Thank you for letting us know, ${guestName}. We'll miss you!`;
    }

    rsvpForm.reset();
  });
}


/* ==========================================
   THE BURN BEFORE CHRISTMAS
   Vintage Christmas Invitation Theme
========================================== */

:root {
  --paper: #f7dfc4;
  --paper-light: #ffecd7;
  --paper-deep: #eac09d;

  --ink: #59231f;
  --cranberry: #8d303b;
  --cranberry-dark: #67252c;

  --rose: #c96f78;
  --rose-light: #e8a0a0;
  --rose-pale: #f5c9bd;

  --pine: #536348;
  --gold: #b77a45;

  --shadow: rgba(84, 36, 27, .18);

  --serif: "IM Fell English", Georgia, serif;
  --display: "DM Serif Display", Georgia, serif;
  --script: "Great Vibes", cursive;
  --body: "Libre Baskerville", Georgia, serif;
}


/* ==========================================
   GENERAL STYLING
========================================== */

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  color: var(--ink);

  background:
    radial-gradient(
      ellipse at 15% 12%,
      rgba(255,245,224,.72),
      transparent 34%
    ),
    radial-gradient(
      ellipse at 85% 80%,
      rgba(193,113,85,.13),
      transparent 36%
    ),
    #c99d79;

  font-family: var(--body);
  line-height: 1.7;
}

body::before {
  content: "✧  ·  ❦  ·  ✧  ·  ❦  ·  ✧";

  position: fixed;
  inset: 0 0 auto;
  height: 25px;

  text-align: center;
  letter-spacing: 1.2rem;

  color: rgba(100,43,34,.35);

  pointer-events: none;
  z-index: 5;

  font-size: 11px;
}


/* ==========================================
   MAIN PAPER CONTAINER
========================================== */

.paper-shell {
  max-width: 1120px;
  margin: 22px auto;
  padding: 0 24px;

  background:
    radial-gradient(
      circle at 12% 18%,
      rgba(255,255,255,.34),
      transparent 22%
    ),
    radial-gradient(
      circle at 86% 72%,
      rgba(188,112,76,.08),
      transparent 26%
    ),
    repeating-linear-gradient(
      7deg,
      rgba(117,66,42,.018) 0 1px,
      transparent 1px 5px
    ),
    var(--paper);

  border: 7px double #a96b4c;

  outline: 1px solid rgba(255,236,205,.7);

  box-shadow:
    0 18px 55px rgba(53,26,19,.3),
    inset 0 0 45px rgba(157,91,54,.12);

  position: relative;
  overflow: hidden;
}

.paper-shell::before,
.paper-shell::after {
  content: "❧";

  position: absolute;
  top: 10px;

  color: var(--rose);
  font-size: 45px;

  opacity: .75;
  z-index: 1;
}

.paper-shell::before {
  left: 14px;
}

.paper-shell::after {
  right: 14px;
  transform: scaleX(-1);
}

.framed-section {
  position: relative;
}


