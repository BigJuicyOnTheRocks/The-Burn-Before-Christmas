/* ==========================================
   COUNTDOWN
========================================== */

.countdown-section {
  text-align: center;

  padding: 35px 20px 32px;

  background: rgba(198,111,116,.13);

  border-bottom: 1px solid rgba(141,48,59,.25);
}

.countdown-section h2,
.section-heading h2,
.ritual-section h2,
.rsvp-section h2 {
  font: clamp(34px, 5vw, 49px) var(--display);

  color: var(--cranberry);

  margin: 0 0 12px;
}

.countdown {
  display: flex;

  justify-content: center;
  align-items: center;

  gap: clamp(7px, 2vw, 18px);
}

.time-tile {
  min-width: clamp(58px, 10vw, 95px);

  padding: 10px 7px 7px;

  background: rgba(255,240,218,.72);

  border: 1px solid #c78278;

  box-shadow:
    inset 0 0 0 3px rgba(255,255,255,.35);
}

.time-tile span {
  display: block;

  font: clamp(29px, 5vw, 45px)/1 var(--display);

  color: var(--cranberry);
  font-variant-numeric: tabular-nums;
}

.time-tile small {
  display: block;

  margin-top: 6px;

  font-size: 9px;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.time-colon {
  color: var(--cranberry);
  font: 28px var(--display);
}

.countdown-caption {
  font: italic 15px var(--serif);
  margin: 13px 0 0;
}


/* ==========================================
   SECTION HEADINGS AND CONTENT
========================================== */

.content-section,
.schedule-section,
.bring-section,
.details-section,
.faq-section {
  padding: 58px clamp(20px, 7vw, 80px);

  text-align: center;

  border-bottom: 1px solid rgba(141,48,59,.25);
}

.section-heading {
  text-align: center;
  margin-bottom: 22px;
}

.section-heading .section-eyebrow {
  margin: 3px 0 0;
}

.section-heading h2 {
  margin: 0;
}

.ornament {
  color: var(--rose);
  font-size: 31px;
  display: block;
  line-height: 1;
}


/* ==========================================
   GATHERING
========================================== */

.intro-copy {
  max-width: 700px;

  margin: 0 auto 22px;

  font: 20px/1.7 var(--serif);
  text-align: center;
}

.gathering-ribbon {
  max-width: 650px;

  margin: 0 auto;
  padding: 12px;

  border-top: 1px solid var(--rose);
  border-bottom: 1px solid var(--rose);

  color: var(--cranberry);

  font: 20px var(--serif);
}

.small-copy {
  max-width: 650px;

  margin: 20px auto 0;

  font: italic 15px/1.8 var(--serif);
}


/* ==========================================
   SCHEDULE
========================================== */

.schedule-section {
  background: rgba(255,241,218,.42);
}

.schedule-list {
  max-width: 700px;
  margin: 0 auto;
  text-align: left;
}

.schedule-item {
  display: flex;
  align-items: center;
  gap: 22px;

  padding: 17px 10px;

  border-bottom: 1px dashed rgba(141,48,59,.42);
}

.schedule-item:last-child {
  border-bottom: 0;
}

.schedule-icon {
  flex: 0 0 62px;

  width: 62px;
  height: 62px;

  display: grid;
  place-items: center;

  border: 1px solid var(--rose);
  border-radius: 50%;

  color: var(--cranberry);
  font-size: 30px;

  background: rgba(245,201,189,.42);
}

.schedule-item h3 {
  margin: 0;

  font: 25px var(--display);
  color: var(--cranberry);
}

.schedule-item p {
  margin: 0;
  font: 17px var(--serif);
}

.schedule-item small {
  color: #765047;
  font-size: 12px;
}


/* ==========================================
   BURNING RITUAL
========================================== */

.ritual-section {
  padding: 60px clamp(20px, 8vw, 100px);

  text-align: center;
  color: #fff0db;

  background:
    radial-gradient(
      ellipse at center,
      #a94c4b,
      #762e36 75%
    );

  border-bottom: 1px solid #5b242b;
}

.ritual-section .section-eyebrow {
  color: #f4c6ae;
}

.ritual-section h2 {
  color: #fff0db;
}

.ritual-section > p:not(.section-eyebrow) {
  max-width: 690px;

  margin: 0 auto;

  font: 19px/1.8 var(--serif);
}

.ritual-star {
  color: #f2c59b;
  font-size: 32px;
}

.ritual-note {
  display: flex;

  align-items: center;
  gap: 15px;

  max-width: 680px;

  margin: 24px auto;
  padding: 14px 20px;

  border: 1px solid rgba(255,220,190,.55);

  background: rgba(55,20,25,.18);

  text-align: left;
}

.ritual-note span {
  font-size: 34px;
  color: #f5c7b5;
}

.ritual-note p {
  margin: 0;
  font: italic 14px/1.7 var(--serif);
}

.ritual-bottom {
  color: #f7cbb6;
  font: 26px var(--script);
}


/* ==========================================
   WHAT TO BRING
========================================== */

.bring-grid {
  display: grid;

  grid-template-columns: repeat(4,1fr);
  gap: 15px;
}

.bring-grid > div {
  padding: 18px 8px;

  border: 1px solid rgba(141,48,59,.32);

  background: rgba(255,242,222,.42);
}

.bring-grid span {
  color: var(--cranberry);
  font-size: 31px;
}

.bring-grid h3 {
  margin: 4px 0;

  color: var(--cranberry);
  font: 21px var(--display);
}

.bring-grid p {
  margin: 0;
  font: italic 12px var(--serif);
}


/* ==========================================
   EVENT DETAILS
========================================== */

.details-section {
  background: rgba(255,241,218,.45);
}

.details-card {
  max-width: 650px;

  margin: 0 auto;
  padding: 10px 24px;

  border: 1px solid #c77e76;

  background: rgba(255,248,231,.55);
}

.details-card div {
  display: grid;

  grid-template-columns: 150px 1fr;
  gap: 12px;

  padding: 12px 0;

  border-bottom: 1px dashed rgba(141,48,59,.3);

  text-align: left;
}

.details-card div:last-child {
  border-bottom: 0;
}

.details-card small {
  color: var(--cranberry);

  letter-spacing: .14em;
  font-size: 10px;
}

.details-card strong {
  font: 17px var(--serif);
}

.privacy-note {
  font: italic 12px var(--serif);
  margin: 15px 0 0;
}


/* ==========================================
   RSVP
========================================== */

.rsvp-section {
  text-align: center;

  padding: 55px 20px;

  background: rgba(201,111,120,.16);

  border-bottom: 1px solid rgba(141,48,59,.25);
}

.envelope-seal {
  width: 52px;
  height: 52px;

  display: grid;
  place-items: center;

  margin: 0 auto 12px;

  border-radius: 50%;

  color: #fff0db;
  background: var(--cranberry);

  border: 3px double #f5c7ad;

  font-size: 25px;
}

.rsvp-section > p:not(.section-eyebrow) {
  font: 16px var(--serif);
}

#rsvp-form {
  max-width: 420px;

  margin: 20px auto 0;

  text-align: left;
}

#rsvp-form label {
  display: block;

  margin: 13px 0 5px;

  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .1em;

  color: var(--cranberry);
}

#rsvp-form input,
#rsvp-form select {
  width: 100%;

  padding: 12px;

  color: var(--ink);

  background: rgba(255,248,231,.8);

  border: 1px solid #bd7773;
  border-radius: 3px;

  font: 15px var(--serif);
}

#rsvp-form button {
  width: 100%;
  margin-top: 20px;
}

.form-note {
  text-align: center;

  font: italic 11px/1.6 var(--serif);

  color: #785047;
}


/* ==========================================
   FREQUENTLY ASKED QUESTIONS
========================================== */

.faq-section details {
  max-width: 700px;

  margin: 0 auto;
  padding: 15px 5px;

  border-bottom: 1px dashed rgba(141,48,59,.4);

  text-align: left;
}

.faq-section summary {
  cursor: pointer;

  color: var(--cranberry);

  font: 20px var(--serif);
}

.faq-section details p {
  margin: 10px 0 0;
  font-size: 13px;
}


/* ==========================================
   FOOTER
========================================== */

.site-footer {
  padding: 32px 20px 28px;

  text-align: center;

  background: rgba(141,48,59,.1);
}

.footer-bow {
  font-size: 43px;
}

.footer-script {
  margin: 0;

  font: 35px var(--script);
  color: var(--cranberry);
}

.site-footer > p:not(.footer-script) {
  margin: 2px 0;
  font: 19px var(--display);
}

.site-footer small {
  font: 11px var(--serif);
}

.footer-flourish {
  margin-top: 12px;

  color: var(--gold);
  letter-spacing: .6em;
}


/* ==========================================
   MOBILE RESPONSIVENESS
========================================== */

@media (max-width: 760px) {

  .paper-shell {
    margin: 0;
    padding: 0 12px;
    border-width: 4px;
  }

  .site-header {
    padding: 12px 8px;
    flex-wrap: wrap;
  }

  .brand {
    font-size: 18px;
  }

  .menu-toggle {
    display: block;
  }

  .site-nav {
    display: none;

    flex-basis: 100%;
    flex-direction: column;

    gap: 12px;
    padding: 12px 0 8px;
  }

  .site-nav.open {
    display: flex;
  }

  .hero {
    padding: 42px 12px 30px;
  }

  .hero-art-wrap {
    grid-template-columns: 1fr 1.6fr;
  }

  .hero-copy {
    grid-column: 1;
    grid-row: 1;
    font-size: 15px;
  }

  .bunny-art {
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  .hero-side-note {
    grid-column: 1;
    grid-row: 2;
    font-size: 14px;
  }

  .hero-date {
    margin-top: 8px;
  }

  .date-line {
    font-size: 27px;
  }

  .arrival-line {
    font-size: 21px;
  }

  .bring-grid {
    grid-template-columns: repeat(2,1fr);
  }

  .details-card {
    padding: 8px 12px;
  }

  .details-card div {
    grid-template-columns: 105px 1fr;
  }

  .details-card strong {
    font-size: 15px;
  }
}


/* ==========================================
   SMALL PHONE SCREENS
========================================== */

@media (max-width: 420px) {

  .hero h1 {
    font-size: 43px;
  }

  .hero h1 em {
    font-size: 70px;
  }

  .hero-art-wrap {
    gap: 0;
  }

  .hero-copy {
    font-size: 13px;
  }

  .hero-side-note {
    font-size: 12px;
  }

  .countdown {
    gap: 4px;
  }

  .time-tile {
    min-width: 54px;
    padding: 8px 3px;
  }

  .time-tile span {
    font-size: 27px;
  }

  .time-tile small {
    font-size: 8px;
  }

  .time-colon {
    font-size: 20px;
  }

  .schedule-item {
    gap: 12px;
  }

  .schedule-icon {
    flex-basis: 48px;

    width: 48px;
    height: 48px;

    font-size: 24px;
  }

  .schedule-item h3 {
    font-size: 21px;
  }

  .details-card div {
    grid-template-columns: 1fr;
    gap: 2px;
  }

}
